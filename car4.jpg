<!DOCTYPE html>
<html lang="ka">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>სერაფიტა — ადმინ პანელი</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#F0F4F8;--bg2:#E4EDF5;--dark:#0D1F35;--accent:#8BAED4;--accent2:#1B3A5C;
  --mid:#4A6A8A;--light:#8AAAC8;--white:#F8FBFF;--red:#c0392b;--green:#27ae60;
}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--dark);min-height:100vh}

/* LOGIN */
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
.login-box{background:var(--white);border:1px solid rgba(139,174,212,0.25);border-radius:8px;padding:48px 40px;width:100%;max-width:380px;box-shadow:6px 6px 0 rgba(13,31,53,0.12)}
.login-logo{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:300;color:var(--dark);text-align:center;margin-bottom:6px}
.login-logo span{color:var(--accent);font-style:italic}
.login-sub{font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:var(--light);text-align:center;margin-bottom:32px}
.login-box input{width:100%;padding:13px 16px;background:var(--bg2);border:1px solid rgba(139,174,212,0.25);font-family:'Inter',sans-serif;font-size:13px;color:var(--dark);outline:none;border-radius:3px;margin-bottom:12px;transition:border-color 0.2s}
.login-box input:focus{border-color:var(--accent)}
.login-box button{width:100%;padding:14px;background:var(--dark);color:var(--white);font-family:'Inter',sans-serif;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;border:none;cursor:pointer;border-radius:3px;box-shadow:3px 3px 0 var(--accent2);transition:transform 0.2s,box-shadow 0.2s}
.login-box button:hover{transform:translate(-2px,-2px);box-shadow:5px 5px 0 var(--accent2)}
.login-err{font-size:12px;color:var(--red);text-align:center;margin-top:10px;display:none}

/* ADMIN LAYOUT */
.admin-wrap{display:none;min-height:100vh;flex-direction:column}
.admin-nav{background:var(--dark);padding:0 32px;display:flex;align-items:center;justify-content:space-between;height:60px;border-bottom:2px solid var(--accent2)}
.admin-nav-logo{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:300;color:var(--white)}
.admin-nav-logo span{color:var(--accent);font-style:italic}
.admin-nav-right{display:flex;align-items:center;gap:16px}
.admin-user{font-size:12px;color:rgba(255,255,255,0.5);letter-spacing:0.05em}
.admin-user strong{color:var(--accent);font-weight:500}
.logout-btn{padding:7px 16px;background:transparent;color:rgba(255,255,255,0.5);border:1px solid rgba(255,255,255,0.15);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;border-radius:3px;transition:all 0.2s;font-family:'Inter',sans-serif}
.logout-btn:hover{color:white;border-color:rgba(255,255,255,0.4)}
.back-btn{padding:7px 16px;background:var(--accent2);color:white;border:none;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;border-radius:3px;font-family:'Inter',sans-serif;text-decoration:none;display:inline-flex;align-items:center;gap:6px}

.admin-body{display:flex;flex:1}
.admin-sidebar{width:220px;background:var(--white);border-right:1px solid rgba(139,174,212,0.2);padding:24px 0;flex-shrink:0}
.sidebar-section{padding:8px 20px 4px;font-size:9px;letter-spacing:0.25em;text-transform:uppercase;color:var(--light)}
.sidebar-btn{display:block;width:100%;padding:10px 20px;background:none;border:none;text-align:left;font-family:'Inter',sans-serif;font-size:13px;color:var(--mid);cursor:pointer;transition:all 0.2s;border-left:3px solid transparent}
.sidebar-btn:hover{background:var(--bg2);color:var(--dark)}
.sidebar-btn.active{background:var(--bg2);color:var(--accent2);border-left-color:var(--accent2);font-weight:500}

.admin-main{flex:1;padding:32px;overflow-y:auto}
.panel{display:none}
.panel.active{display:block}
.panel-title{font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:300;color:var(--dark);margin-bottom:6px}
.panel-sub{font-size:13px;color:var(--mid);margin-bottom:28px}

/* CARDS */
.admin-card{background:var(--white);border:1px solid rgba(139,174,212,0.2);border-radius:6px;padding:24px;margin-bottom:16px;box-shadow:3px 3px 0 rgba(13,31,53,0.06)}
.admin-card h3{font-size:13px;font-weight:500;color:var(--dark);margin-bottom:16px;letter-spacing:0.05em}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px}
.form-row.single{grid-template-columns:1fr}
label{font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:var(--mid);display:block;margin-bottom:5px}
input,textarea,select{width:100%;padding:11px 14px;background:var(--bg2);border:1px solid rgba(139,174,212,0.25);font-family:'Inter',sans-serif;font-size:13px;color:var(--dark);outline:none;border-radius:3px;transition:border-color 0.2s}
input:focus,textarea:focus,select:focus{border-color:var(--accent)}
textarea{resize:vertical;min-height:80px}
.btn-save{padding:11px 28px;background:var(--dark);color:var(--white);font-family:'Inter',sans-serif;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;border:none;cursor:pointer;border-radius:3px;box-shadow:3px 3px 0 var(--accent2);transition:transform 0.2s,box-shadow 0.2s}
.btn-save:hover{transform:translate(-2px,-2px);box-shadow:5px 5px 0 var(--accent2)}
.btn-danger{padding:9px 20px;background:transparent;color:var(--red);border:1px solid rgba(192,57,43,0.35);font-family:'Inter',sans-serif;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;border-radius:3px;transition:all 0.2s}
.btn-danger:hover{background:var(--red);color:white}
.btn-accent{padding:9px 20px;background:var(--accent2);color:white;border:none;font-family:'Inter',sans-serif;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;border-radius:3px;transition:all 0.2s}
.btn-accent:hover{background:var(--dark)}
.success-msg{font-size:12px;color:var(--green);margin-top:8px;display:none}

/* PRODUCT LIST */
.product-list{display:flex;flex-direction:column;gap:10px}
.product-row{display:grid;grid-template-columns:60px 1fr auto auto;gap:12px;align-items:center;background:var(--white);border:1px solid rgba(139,174,212,0.15);border-radius:5px;padding:12px 16px}
.product-row img{width:52px;height:52px;object-fit:cover;border-radius:3px}
.product-row-name{font-size:13px;color:var(--dark);font-weight:400}
.product-row-price{font-size:12px;color:var(--mid)}
.product-row-actions{display:flex;gap:8px}
.btn-edit{padding:6px 14px;background:var(--bg2);color:var(--mid);border:1px solid rgba(139,174,212,0.25);font-size:11px;cursor:pointer;border-radius:3px;font-family:'Inter',sans-serif;transition:all 0.2s}
.btn-edit:hover{border-color:var(--accent);color:var(--dark)}
.btn-del{padding:6px 14px;background:transparent;color:rgba(192,57,43,0.7);border:1px solid rgba(192,57,43,0.2);font-size:11px;cursor:pointer;border-radius:3px;font-family:'Inter',sans-serif;transition:all 0.2s}
.btn-del:hover{background:var(--red);color:white;border-color:var(--red)}

/* CATEGORY GRID */
.cat-grid-admin{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:20px}
.cat-item-admin{background:var(--white);border:1px solid rgba(139,174,212,0.2);border-radius:5px;padding:16px;display:flex;flex-direction:column;gap:8px}
.cat-item-name{font-size:14px;font-weight:500;color:var(--dark)}
.cat-item-count{font-size:11px;color:var(--light)}

/* REVIEWS LIST */
.rev-admin-list{display:flex;flex-direction:column;gap:10px}
.rev-admin-item{background:var(--white);border:1px solid rgba(139,174,212,0.15);border-radius:5px;padding:14px 16px;display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.rev-admin-body{flex:1}
.rev-admin-meta{font-size:11px;color:var(--light);margin-bottom:4px}
.rev-admin-stars{color:var(--accent);font-size:13px;margin-bottom:4px}
.rev-admin-text{font-size:13px;color:var(--mid)}

/* EDIT MODAL */
.edit-overlay{display:none;position:fixed;inset:0;background:rgba(13,31,53,0.7);z-index:900;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)}
.edit-overlay.open{display:flex}
.edit-box{background:var(--white);border-radius:6px;padding:32px;width:100%;max-width:500px;box-shadow:8px 8px 0 rgba(13,31,53,0.15)}
.edit-box h3{font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:300;font-style:italic;color:var(--dark);margin-bottom:20px}
.edit-close{float:right;background:none;border:none;font-size:20px;cursor:pointer;color:var(--light);margin-top:-4px}

.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px}
.stat-card{background:var(--white);border:1px solid rgba(139,174,212,0.2);border-radius:5px;padding:16px;text-align:center;box-shadow:3px 3px 0 rgba(13,31,53,0.06)}
.stat-num{font-family:'Cormorant Garamond',serif;font-size:36px;font-weight:300;color:var(--accent2)}
.stat-lbl{font-size:10px;letter-spacing:0.15em;text-transform:uppercase;color:var(--light);margin-top:4px}

@media(max-width:768px){
  .admin-body{flex-direction:column}
  .admin-sidebar{width:100%;border-right:none;border-bottom:1px solid rgba(139,174,212,0.2);padding:12px 0;display:flex;overflow-x:auto;gap:0}
  .sidebar-btn{white-space:nowrap;border-left:none;border-bottom:3px solid transparent;padding:10px 16px}
  .sidebar-btn.active{border-left:none;border-bottom-color:var(--accent2)}
  .sidebar-section{display:none}
  .stats-grid{grid-template-columns:1fr 1fr}
  .form-row{grid-template-columns:1fr}
  .product-row{grid-template-columns:50px 1fr;grid-template-rows:auto auto}
  .product-row-actions{grid-column:1/-1}
}
</style>
</head>
<body>

<!-- LOGIN -->
<div class="login-wrap" id="loginWrap">
  <div class="login-box">
    <div class="login-logo">Sera<span>phita</span></div>
    <p class="login-sub">ადმინ პანელი</p>
    <input type="text" id="loginName" placeholder="სახელი" autocomplete="off">
    <input type="password" id="loginPass" placeholder="პაროლი" onkeydown="if(event.key==='Enter')doLogin()">
    <button onclick="doLogin()">შესვლა</button>
    <p class="login-err" id="loginErr">მომხმარებელი ან პაროლი არასწორია</p>
  </div>
</div>

<!-- ADMIN -->
<div class="admin-wrap" id="adminWrap">
  <nav class="admin-nav">
    <div class="admin-nav-logo">Sera<span>phita</span> <span style="font-size:12px;font-family:'Inter',sans-serif;color:rgba(255,255,255,0.3);font-style:normal;font-weight:300;margin-left:8px">ადმინ</span></div>
    <div class="admin-nav-right">
      <span class="admin-user">შესულია: <strong id="currentUser"></strong></span>
      <a href="index.html" class="back-btn">← საიტი</a>
      <button class="logout-btn" onclick="doLogout()">გასვლა</button>
    </div>
  </nav>

  <div class="admin-body">
    <div class="admin-sidebar">
      <p class="sidebar-section">მთავარი</p>
      <button class="sidebar-btn active" onclick="showPanel('dashboard')">📊 სტატისტიკა</button>
      <p class="sidebar-section">კატალოგი</p>
      <button class="sidebar-btn" onclick="showPanel('categories')">🗂 კატეგორიები</button>
      <button class="sidebar-btn" onclick="showPanel('products')">🛍 პროდუქტები</button>
      <button class="sidebar-btn" onclick="showPanel('add-product')">➕ ახალი პროდუქტი</button>
      <p class="sidebar-section">კომენტარები</p>
      <button class="sidebar-btn" onclick="showPanel('reviews')">★ შეფასებები</button>
      <p class="sidebar-section">პარამეტრები</p>
      <button class="sidebar-btn" onclick="showPanel('settings')">⚙️ საიტის პარამეტრები</button>
    </div>

    <div class="admin-main">

      <!-- DASHBOARD -->
      <div class="panel active" id="panel-dashboard">
        <h2 class="panel-title">სტატისტიკა</h2>
        <p class="panel-sub">კეთილი იყოს თქვენი დაბრუნება, <strong id="welcomeName"></strong></p>
        <div class="stats-grid" id="statsGrid"></div>
        <div class="admin-card">
          <h3>ბოლო შეფასებები</h3>
          <div id="recentReviews"></div>
        </div>
      </div>

      <!-- CATEGORIES -->
      <div class="panel" id="panel-categories">
        <h2 class="panel-title">კატეგორიები</h2>
        <p class="panel-sub">კატეგორიების მართვა</p>
        <div class="admin-card">
          <h3>ახალი კატეგორია</h3>
          <div class="form-row">
            <div><label>კატეგორიის სახელი (ქართ.)</label><input type="text" id="newCatName" placeholder="მაგ. საყელოები"></div>
            <div><label>ინგლ. სახელი (url)</label><input type="text" id="newCatSlug" placeholder="მაგ. necklaces"></div>
          </div>
          <div class="form-row single">
            <div><label>სამუქი ფოტო (url ან images/...)</label><input type="text" id="newCatImg" placeholder="images/bags/bag1.jpg"></div>
          </div>
          <button class="btn-save" onclick="addCategory()">კატეგორიის დამატება</button>
          <p class="success-msg" id="catSuccess">✓ კატეგორია დაემატა</p>
        </div>
        <div class="admin-card">
          <h3>არსებული კატეგორიები</h3>
          <div class="cat-grid-admin" id="catGridAdmin"></div>
        </div>
      </div>

      <!-- PRODUCTS -->
      <div class="panel" id="panel-products">
        <h2 class="panel-title">პროდუქტები</h2>
        <p class="panel-sub">ყველა პროდუქტის სია</p>
        <div style="display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap">
          <select id="filterCat" onchange="renderProducts()" style="width:auto;padding:9px 14px">
            <option value="">ყველა კატეგორია</option>
          </select>
          <input type="text" id="filterSearch" placeholder="ძიება..." oninput="renderProducts()" style="width:200px">
        </div>
        <div class="product-list" id="productList"></div>
      </div>

      <!-- ADD PRODUCT -->
      <div class="panel" id="panel-add-product">
        <h2 class="panel-title">ახალი პროდუქტი</h2>
        <p class="panel-sub">ახალი ნამუშევრის დამატება</p>
        <div class="admin-card">
          <div class="form-row">
            <div><label>კატეგორია</label>
              <select id="addProdCat"></select>
            </div>
            <div><label>ფასი (₾)</label><input type="number" id="addProdPrice" placeholder="100" value="100"></div>
          </div>
          <div class="form-row single">
            <div><label>ფოტოს მისამართი</label><input type="text" id="addProdImg" placeholder="images/bags/bag1.jpg"></div>
          </div>
          <div class="form-row single">
            <div><label>აღწერა</label><textarea id="addProdDesc" placeholder="ნამუშევრის აღწერა..."></textarea></div>
          </div>
          <div class="form-row single">
            <div><label>სახელი (სურვილისამებრ)</label><input type="text" id="addProdName" placeholder="მაგ. მარგალიტის ჩანთა"></div>
          </div>
          <button class="btn-save" onclick="addProduct()">პროდუქტის დამატება</button>
          <p class="success-msg" id="prodSuccess">✓ პროდუქტი დაემატა</p>
        </div>
      </div>

      <!-- REVIEWS -->
      <div class="panel" id="panel-reviews">
        <h2 class="panel-title">შეფასებები</h2>
        <p class="panel-sub">მომხმარებლების კომენტარები</p>
        <div style="display:flex;gap:10px;margin-bottom:16px">
          <select id="filterRevCat" onchange="renderReviewsAdmin()" style="width:auto;padding:9px 14px">
            <option value="">ყველა</option>
          </select>
        </div>
        <div class="rev-admin-list" id="revAdminList"></div>
      </div>

      <!-- SETTINGS -->
      <div class="panel" id="panel-settings">
        <h2 class="panel-title">პარამეტრები</h2>
        <p class="panel-sub">საიტის ძირითადი პარამეტრები</p>
        <div class="admin-card">
          <h3>ტექსტები</h3>
          <div class="form-row single"><div><label>Hero სათაური</label><input type="text" id="setHeroTitle" placeholder="ყოველი ნაკერი — სიყვარული"></div></div>
          <div class="form-row single"><div><label>Hero აღწერა</label><textarea id="setHeroDesc"></textarea></div></div>
          <div class="form-row single"><div><label>Gallery სათაური</label><input type="text" id="setGalleryTitle" placeholder="ხელნაკეთი ნამუშევრები"></div></div>
          <div class="form-row single"><div><label>Contact სათაური</label><input type="text" id="setContactTitle" placeholder="შეუკვეთეთ ინდივიდუალური ნამუშევარი"></div></div>
          <button class="btn-save" onclick="saveSettings()">შენახვა</button>
          <p class="success-msg" id="settingsSuccess">✓ შენახულია</p>
        </div>
        <div class="admin-card">
          <h3>მონაცემების მართვა</h3>
          <p style="font-size:13px;color:var(--mid);margin-bottom:16px">ყველა მომხმარებლის შეფასება წაიშლება</p>
          <button class="btn-danger" onclick="clearAllReviews()">ყველა შეფასების წაშლა</button>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- EDIT MODAL -->
<div class="edit-overlay" id="editOverlay">
  <div class="edit-box">
    <button class="edit-close" onclick="closeEdit()">×</button>
    <h3>პროდუქტის რედაქტირება</h3>
    <input type="hidden" id="editId">
    <div class="form-row">
      <div><label>კატეგორია</label><select id="editCat"></select></div>
      <div><label>ფასი (₾)</label><input type="number" id="editPrice"></div>
    </div>
    <div class="form-row single"><div><label>ფოტო</label><input type="text" id="editImg"></div></div>
    <div class="form-row single"><div><label>სახელი</label><input type="text" id="editName"></div></div>
    <div class="form-row single"><div><label>აღწერა</label><textarea id="editDesc"></textarea></div></div>
    <div style="display:flex;gap:10px;margin-top:8px">
      <button class="btn-save" onclick="saveEdit()">შენახვა</button>
      <button class="btn-danger" onclick="closeEdit()">გაუქმება</button>
    </div>
  </div>
</div>

<script>
const ADMINS = {
  'სერაფიტა': 'Leluchananucha2',
  'ლელა თენიეშვილი': 'Leluchananucha2'
};

const DB_PRODUCTS = 'ser_products';
const DB_CATS = 'ser_cats';
const DB_REVIEWS = 'seraphita_reviews';
const DB_SETTINGS = 'ser_settings';

function load(k) { try { return JSON.parse(localStorage.getItem(k)) || null; } catch { return null; } }
function save(k,v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} }

function defaultCats() {
  return [
    {id:'bags', name:'ჩანთები', slug:'bags', img:'images/bags/bag10.jpg', count:10},
    {id:'car', name:'მანქანის აქსესუარები', slug:'car', img:'images/car/car3.jpg', count:4},
    {id:'bouquets', name:'თაიგულები', slug:'bouquets', img:'images/bouquets/bouquet3.jpg', count:4}
  ];
}

function defaultProducts() {
  const cats = [{id:'bags',label:'ჩანთა'},{id:'car',label:'მანქანის აქსესუარი'},{id:'bouquets',label:'თაიგული'}];
  const prods = [];
  [[10,'bags','ჩანთა'],[4,'car','მანქანის აქსესუარი'],[4,'bouquets','თაიგული']].forEach(([n,cat,lbl])=>{
    for(let i=1;i<=n;i++) prods.push({
      id: cat+'_'+(i-1), cat, img:`images/${cat}/${cat==='bouquets'?'bouquet':cat==='car'?'car':'bag'}${i}.jpg`,
      price:100, name:'', desc:'ჩემი დაქუს შექმნილი ზე იდეალური სასწაული ჩანთა და თუ შეიძენთ მოულოდნელი სიხარული გეწვევათ'
    });
  });
  return prods;
}

function getCats() { return load(DB_CATS) || defaultCats(); }
function getProducts() { return load(DB_PRODUCTS) || defaultProducts(); }
function getReviews() { return load(DB_REVIEWS) || {}; }
function getSettings() { return load(DB_SETTINGS) || {}; }

// AUTH
function doLogin() {
  const name = document.getElementById('loginName').value.trim();
  const pass = document.getElementById('loginPass').value;
  if (ADMINS[name] && ADMINS[name] === pass) {
    sessionStorage.setItem('admin_user', name);
    document.getElementById('loginWrap').style.display = 'none';
    document.getElementById('adminWrap').style.display = 'flex';
    document.getElementById('currentUser').textContent = name;
    document.getElementById('welcomeName').textContent = name;
    initAdmin();
  } else {
    document.getElementById('loginErr').style.display = 'block';
  }
}
function doLogout() {
  sessionStorage.removeItem('admin_user');
  location.reload();
}

// Check if already logged in
window.addEventListener('DOMContentLoaded', () => {
  const u = sessionStorage.getItem('admin_user');
  if (u && ADMINS[u]) {
    document.getElementById('loginWrap').style.display = 'none';
    document.getElementById('adminWrap').style.display = 'flex';
    document.getElementById('currentUser').textContent = u;
    document.getElementById('welcomeName').textContent = u;
    initAdmin();
  }
});

function initAdmin() {
  renderStats();
  renderRecentReviews();
  renderCatGridAdmin();
  renderProducts();
  populateCatSelects();
  renderReviewsAdmin();
  loadSettings();
}

function showPanel(id) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.sidebar-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('panel-'+id).classList.add('active');
  event.currentTarget.classList.add('active');
  if(id==='products') renderProducts();
  if(id==='reviews') renderReviewsAdmin();
  if(id==='categories') renderCatGridAdmin();
}

// STATS
function renderStats() {
  const prods = getProducts();
  const cats = getCats();
  const revs = getReviews();
  const totalRevs = Object.values(revs).reduce((s,a)=>s+a.length,0);
  const allRevs = Object.values(revs).flat();
  const avgStars = allRevs.length ? (allRevs.reduce((s,r)=>s+r.stars,0)/allRevs.length).toFixed(1) : '—';
  document.getElementById('statsGrid').innerHTML = [
    [prods.length,'პროდუქტი'],
    [cats.length,'კატეგორია'],
    [totalRevs,'შეფასება'],
    [avgStars,'საშ. ვარსკვლავი']
  ].map(([n,l])=>`<div class="stat-card"><div class="stat-num">${n}</div><div class="stat-lbl">${l}</div></div>`).join('');
}

function renderRecentReviews() {
  const revs = getReviews();
  const all = Object.entries(revs).flatMap(([k,arr])=>arr.map(r=>({...r,key:k}))).slice(0,5);
  document.getElementById('recentReviews').innerHTML = all.length
    ? all.map(r=>`<div style="padding:10px 0;border-bottom:1px solid rgba(139,174,212,0.12)">
        <span style="font-size:12px;font-weight:500;color:var(--dark)">${r.name}</span>
        <span style="font-size:11px;color:var(--light);margin:0 8px">${r.date}</span>
        <span style="color:var(--accent);font-size:12px">${'★'.repeat(r.stars)}</span>
        <p style="font-size:12px;color:var(--mid);margin-top:4px">${r.text}</p>
      </div>`).join('')
    : '<p style="font-size:13px;color:var(--light)">შეფასებები ჯერ არ არის</p>';
}

// CATEGORIES
function renderCatGridAdmin() {
  const cats = getCats();
  const prods = getProducts();
  document.getElementById('catGridAdmin').innerHTML = cats.map(c=>`
    <div class="cat-item-admin">
      <img src="${c.img}" style="width:100%;height:80px;object-fit:cover;border-radius:3px;margin-bottom:4px" onerror="this.style.display='none'">
      <div class="cat-item-name">${c.name}</div>
      <div class="cat-item-count">${prods.filter(p=>p.cat===c.id).length} პროდუქტი</div>
      <div style="display:flex;gap:6px;margin-top:6px">
        <button class="btn-del" onclick="deleteCat('${c.id}')">წაშლა</button>
      </div>
    </div>`).join('');
}

function addCategory() {
  const name = document.getElementById('newCatName').value.trim();
  const slug = document.getElementById('newCatSlug').value.trim();
  const img = document.getElementById('newCatImg').value.trim();
  if (!name || !slug) { alert('შეავსეთ სახელი'); return; }
  const cats = getCats();
  cats.push({id: slug, name, slug, img: img || '', count: 0});
  save(DB_CATS, cats);
  document.getElementById('newCatName').value = '';
  document.getElementById('newCatSlug').value = '';
  document.getElementById('newCatImg').value = '';
  const s = document.getElementById('catSuccess');
  s.style.display='block'; setTimeout(()=>s.style.display='none',2500);
  renderCatGridAdmin();
  populateCatSelects();
  renderStats();
}

function deleteCat(id) {
  if (!confirm('კატეგორია წაიშლება. დარწმუნებული ხარ?')) return;
  let cats = getCats().filter(c=>c.id!==id);
  save(DB_CATS, cats);
  renderCatGridAdmin();
  renderProducts();
  renderStats();
}

// PRODUCTS
function populateCatSelects() {
  const cats = getCats();
  const opts = cats.map(c=>`<option value="${c.id}">${c.name}</option>`).join('');
  ['addProdCat','editCat','filterCat','filterRevCat'].forEach(id=>{
    const el = document.getElementById(id);
    if (!el) return;
    const extra = id.startsWith('filter') ? '<option value="">ყველა</option>' : '';
    el.innerHTML = extra + opts;
  });
}

function renderProducts() {
  const prods = getProducts();
  const filterCat = document.getElementById('filterCat')?.value || '';
  const search = (document.getElementById('filterSearch')?.value || '').toLowerCase();
  const filtered = prods.filter(p =>
    (!filterCat || p.cat === filterCat) &&
    (!search || p.name.toLowerCase().includes(search) || p.desc.toLowerCase().includes(search) || p.img.toLowerCase().includes(search))
  );
  document.getElementById('productList').innerHTML = filtered.length
    ? filtered.map(p=>`
      <div class="product-row">
        <img src="${p.img}" onerror="this.src=''" alt="">
        <div>
          <div class="product-row-name">${p.name || p.id}</div>
          <div class="product-row-price">${p.price} ₾ · ${getCats().find(c=>c.id===p.cat)?.name||p.cat}</div>
        </div>
        <div class="product-row-actions">
          <button class="btn-edit" onclick='openEdit(${JSON.stringify(p)})'>რედაქტირება</button>
          <button class="btn-del" onclick="deleteProduct('${p.id}')">წაშლა</button>
        </div>
      </div>`).join('')
    : '<p style="font-size:13px;color:var(--light);padding:20px 0">პროდუქტები ვერ მოიძებნა</p>';
}

function addProduct() {
  const cat = document.getElementById('addProdCat').value;
  const price = parseInt(document.getElementById('addProdPrice').value) || 100;
  const img = document.getElementById('addProdImg').value.trim();
  const desc = document.getElementById('addProdDesc').value.trim();
  const name = document.getElementById('addProdName').value.trim();
  if (!img) { alert('შეიყვანეთ ფოტოს მისამართი'); return; }
  const prods = getProducts();
  const id = cat + '_' + Date.now();
  prods.push({id, cat, img, price, desc, name});
  save(DB_PRODUCTS, prods);
  document.getElementById('addProdImg').value = '';
  document.getElementById('addProdDesc').value = '';
  document.getElementById('addProdName').value = '';
  document.getElementById('addProdPrice').value = '100';
  const s = document.getElementById('prodSuccess');
  s.style.display='block'; setTimeout(()=>s.style.display='none',2500);
  renderStats();
}

function deleteProduct(id) {
  if (!confirm('პროდუქტი წაიშლება?')) return;
  save(DB_PRODUCTS, getProducts().filter(p=>p.id!==id));
  renderProducts();
  renderStats();
}

function openEdit(p) {
  document.getElementById('editId').value = p.id;
  document.getElementById('editCat').value = p.cat;
  document.getElementById('editPrice').value = p.price;
  document.getElementById('editImg').value = p.img;
  document.getElementById('editName').value = p.name || '';
  document.getElementById('editDesc').value = p.desc || '';
  document.getElementById('editOverlay').classList.add('open');
}
function closeEdit() { document.getElementById('editOverlay').classList.remove('open'); }
function saveEdit() {
  const id = document.getElementById('editId').value;
  const prods = getProducts();
  const idx = prods.findIndex(p=>p.id===id);
  if (idx < 0) return;
  prods[idx] = {
    ...prods[idx],
    cat: document.getElementById('editCat').value,
    price: parseInt(document.getElementById('editPrice').value) || 100,
    img: document.getElementById('editImg').value.trim(),
    name: document.getElementById('editName').value.trim(),
    desc: document.getElementById('editDesc').value.trim()
  };
  save(DB_PRODUCTS, prods);
  closeEdit();
  renderProducts();
  renderStats();
}

// REVIEWS
function renderReviewsAdmin() {
  const revs = getReviews();
  const filter = document.getElementById('filterRevCat')?.value || '';
  const cats = getCats();
  let all = Object.entries(revs).flatMap(([k,arr])=>arr.map((r,i)=>({...r,key:k,idx:i})));
  if (filter) all = all.filter(r=>r.key.startsWith(filter));
  document.getElementById('revAdminList').innerHTML = all.length
    ? all.map(r=>`
      <div class="rev-admin-item">
        <div class="rev-admin-body">
          <div class="rev-admin-meta">${r.name} · ${r.date} · <em>${r.key}</em></div>
          <div class="rev-admin-stars">${'★'.repeat(r.stars)}${'☆'.repeat(5-r.stars)}</div>
          <div class="rev-admin-text">${r.text}</div>
        </div>
        <button class="btn-del" onclick="deleteReview('${r.key}',${r.idx})">წაშლა</button>
      </div>`).join('')
    : '<p style="font-size:13px;color:var(--light);padding:20px 0">შეფასებები არ არის</p>';
}

function deleteReview(key, idx) {
  if (!confirm('შეფასება წაიშლება?')) return;
  const db = getReviews();
  if (db[key]) { db[key].splice(idx,1); if(!db[key].length) delete db[key]; }
  save(DB_REVIEWS, db);
  renderReviewsAdmin();
  renderRecentReviews();
  renderStats();
}

function clearAllReviews() {
  if (!confirm('ყველა შეფასება წაიშლება. დარწმუნებული ხარ?')) return;
  save(DB_REVIEWS, {});
  renderReviewsAdmin();
  renderRecentReviews();
  renderStats();
}

// SETTINGS
function loadSettings() {
  const s = getSettings();
  if(s.heroTitle) document.getElementById('setHeroTitle').value = s.heroTitle;
  if(s.heroDesc) document.getElementById('setHeroDesc').value = s.heroDesc;
  if(s.galleryTitle) document.getElementById('setGalleryTitle').value = s.galleryTitle;
  if(s.contactTitle) document.getElementById('setContactTitle').value = s.contactTitle;
}
function saveSettings() {
  save(DB_SETTINGS, {
    heroTitle: document.getElementById('setHeroTitle').value,
    heroDesc: document.getElementById('setHeroDesc').value,
    galleryTitle: document.getElementById('setGalleryTitle').value,
    contactTitle: document.getElementById('setContactTitle').value
  });
  const s = document.getElementById('settingsSuccess');
  s.style.display='block'; setTimeout(()=>s.style.display='none',2500);
}

document.getElementById('loginPass').addEventListener('keydown', e => {
  if(e.key==='Enter') doLogin();
});
document.getElementById('editOverlay').addEventListener('click', e => {
  if(e.target===document.getElementById('editOverlay')) closeEdit();
});
</script>
</body>
</html>
